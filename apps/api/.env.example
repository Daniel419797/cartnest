NODE_ENV=development
HOST=0.0.0.0
PORT=4000
DATABASE_URL=postgresql://cartnest:cartnest_dev_only@127.0.0.1:5432/cartnest
# Optional Prisma migration connection. On Render + Supabase, use the Supavisor Session pooler URL (port 5432), not the db.<project-ref>.supabase.co direct URL unless the Supabase IPv4 add-on is enabled.
MIGRATION_DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379
WEB_BASE_URL=http://localhost:3000
API_PUBLIC_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
MFA_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
AUTH_COOKIE_SECURE=false
AUTH_EXPOSE_DEVELOPMENT_TOKENS=false
# Require a verified email or phone before a user can create a vendor account.
VENDOR_REQUIRE_VERIFIED_IDENTIFIER=true
# Required in production for email verification and password-reset delivery.
# Use a Resend API key and a sender address/domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cartnest-media
R2_PUBLIC_BASE_URL=
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co/
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3/
PAYMENT_CALLBACK_URL=http://localhost:3000/payment/callback
# Keep false while CartNest uses delivery-gated settlement. Collection-time splits
# must be enabled only after finance/operations approve the provider behavior.
PAYMENT_COLLECTION_SPLITS_ENABLED=false

# GIGL development defaults. Production base URL and contracted credentials must
# be confirmed with GIG Logistics before live shipment booking is enabled.
GIGL_ACCESS_TOKEN=
GIGL_CUSTOMER_CODE=
GIGL_BASE_URL=https://dev-thirdpartynode.theagilitysystems.com/
