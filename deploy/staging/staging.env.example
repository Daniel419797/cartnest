# Copy to deploy/staging/staging.env on the staging host and replace every
# placeholder secret before starting the stack. Never commit the real file.

WEB_HOST=staging.cartnest.example
API_HOST=api.staging.cartnest.example
# This is the API origin. Frontend clients append their versioned /api/v1 paths.
NEXT_PUBLIC_API_BASE_URL=https://api.staging.cartnest.example
WEB_BASE_URL=https://staging.cartnest.example
API_PUBLIC_BASE_URL=https://api.staging.cartnest.example
CORS_ORIGINS=https://staging.cartnest.example
CADDY_ACME_EMAIL=ops@example.com

RELEASE_SHA=replace-with-git-sha
WEB_IMAGE=ghcr.io/daniel419797/cartnest-web:replace-with-git-sha
API_IMAGE=ghcr.io/daniel419797/cartnest-api:replace-with-git-sha
WORKER_IMAGE=ghcr.io/daniel419797/cartnest-worker:replace-with-git-sha

# Self-contained staging defaults. For managed PostgreSQL/Redis, replace
# DATABASE_URL/REDIS_URL with the managed private/TLS endpoints.
POSTGRES_DB=cartnest
POSTGRES_USER=cartnest
POSTGRES_PASSWORD=replace-with-random-staging-password
DATABASE_URL=postgresql://cartnest:replace-with-random-staging-password@postgres:5432/cartnest
# Optional migration URL. On IPv4-only hosts such as Render, use Supabase Session pooler (port 5432) rather than the direct db.<project-ref>.supabase.co endpoint.
MIGRATION_DATABASE_URL=
REDIS_URL=redis://redis:6379

AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
MFA_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
AUTH_COOKIE_SECURE=true
AUTH_EXPOSE_DEVELOPMENT_TOKENS=false
# Require a verified email or phone before a user can create a vendor account.
VENDOR_REQUIRE_VERIFIED_IDENTIFIER=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.staging.cartnest.example/api/v1/auth/google/callback

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cartnest-staging-media
R2_PUBLIC_BASE_URL=

PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co/
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3/
PAYMENT_CALLBACK_URL=https://staging.cartnest.example/payment/callback
PAYMENT_COLLECTION_SPLITS_ENABLED=false

GIGL_ACCESS_TOKEN=
GIGL_CUSTOMER_CODE=
GIGL_BASE_URL=https://dev-thirdpartynode.theagilitysystems.com/
