{
  "name": "cartnest",
  "version": "0.0.0",
  "private": true,
  "description": "CartNest multi-vendor e-commerce marketplace monorepo",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check": "node scripts/check-doc-links.mjs",
    "security:scan": "node scripts/check-secrets.mjs",
    "security:audit": "pnpm audit --audit-level high",
    "perf:benchmark": "node scripts/performance/http-benchmark.mjs",
    "p12:preflight": "node scripts/staging/preflight.mjs",
    "p12:smoke": "node scripts/staging/smoke.mjs",
    "p12:gate": "node scripts/staging/verify-evidence.mjs",
    "staging:config": "docker compose -f deploy/staging/compose.yaml config",
    "staging:build": "docker compose -f deploy/staging/compose.yaml build",
    "staging:up": "docker compose -f deploy/staging/compose.yaml up -d",
    "staging:down": "docker compose -f deploy/staging/compose.yaml down",
    "staging:logs": "docker compose -f deploy/staging/compose.yaml logs -f",
    "infra:up": "docker compose -f compose.dev.yml up -d",
    "infra:down": "docker compose -f compose.dev.yml down",
    "infra:logs": "docker compose -f compose.dev.yml logs -f",
    "db:generate": "pnpm --filter @repo/database db:generate",
    "db:format": "pnpm --filter @repo/database db:format",
    "db:validate": "pnpm --filter @repo/database db:validate",
    "db:migrate:dev": "pnpm --filter @repo/database db:migrate:dev",
    "db:backup": "node scripts/operations/postgres-backup.mjs",
    "db:restore": "node scripts/operations/postgres-restore.mjs",
    "openapi:generate": "pnpm --filter @repo/contracts build && pnpm --filter @repo/config build && pnpm --filter @repo/database build && pnpm --filter @cartnest/api openapi:generate",
    "api-client:generate": "pnpm --filter @repo/api-client generate",
    "api:generate": "pnpm openapi:generate && pnpm api-client:generate"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "turbo": "2.10.12",
    "typescript": "6.0.3"
  }
}
